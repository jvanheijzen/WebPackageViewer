<Window x:Class="WebPackageLicenseGenerator.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="Web Package License Generator"
 Width="760" Height="660"
 WindowStartupLocation="CenterScreen">
 <Grid Margin="26">
  <Grid.RowDefinitions>
   <RowDefinition Height="Auto"/><RowDefinition Height="16"/>
   <RowDefinition Height="Auto"/><RowDefinition Height="16"/>
   <RowDefinition Height="Auto"/><RowDefinition Height="16"/>
   <RowDefinition Height="Auto"/><RowDefinition Height="16"/>
   <RowDefinition Height="Auto"/><RowDefinition Height="16"/>
   <RowDefinition Height="Auto"/><RowDefinition Height="16"/>
   <RowDefinition Height="Auto"/><RowDefinition Height="*"/>
   <RowDefinition Height="Auto"/>
  </Grid.RowDefinitions>

  <StackPanel Grid.Row="0">
   <TextBlock FontSize="23"
              FontWeight="SemiBold"
              Text="Offline Course License"/>
   <TextBlock Margin="0,5,0,0"
              Foreground="#666666"
              TextWrapping="Wrap"
              Text="One signed machine license unlocks every module packaged with the same Salesforce Product Code."/>
  </StackPanel>

  <Border Grid.Row="2"
          BorderBrush="#D0D0D0"
          BorderThickness="1"
          CornerRadius="4"
          Padding="12">
   <Grid>
    <Grid.ColumnDefinitions>
     <ColumnDefinition Width="*"/>
     <ColumnDefinition Width="Auto"/>
    </Grid.ColumnDefinitions>

    <StackPanel>
     <TextBlock FontWeight="SemiBold"
                Text="Signing Key"/>
     <TextBlock x:Name="KeyStatusTextBlock"
                Margin="0,4,0,0"
                TextWrapping="Wrap"/>
    </StackPanel>

    <StackPanel Grid.Column="1"
                Orientation="Horizontal"
                Margin="12,0,0,0">
     <Button Width="155"
             Height="30"
             Margin="0,0,8,0"
             Content="Export Recovery Backup..."
             Click="ExportRecoveryBackupButton_Click"/>
     <Button Width="155"
             Height="30"
             Content="Restore Recovery Backup..."
             Click="RestoreRecoveryBackupButton_Click"/>
    </StackPanel>
   </Grid>
  </Border>

  <Grid Grid.Row="4">
   <Grid.ColumnDefinitions>
    <ColumnDefinition Width="*"/>
    <ColumnDefinition Width="Auto"/>
   </Grid.ColumnDefinitions>

   <StackPanel>
    <TextBlock Text="Course"
               FontWeight="SemiBold"
               Margin="0,0,0,5"/>
    <ComboBox x:Name="CourseComboBox"
              Height="31"
              DisplayMemberPath="DisplayName"
              SelectionChanged="CourseComboBox_SelectionChanged"/>
   </StackPanel>

   <Button Grid.Column="1"
           Width="125"
           Margin="10,21,0,0"
           Content="Manage Courses..."
           Click="ManageCoursesButton_Click"/>
  </Grid>

  <Grid Grid.Row="6">
   <Grid.ColumnDefinitions>
    <ColumnDefinition Width="*"/>
    <ColumnDefinition Width="18"/>
    <ColumnDefinition Width="*"/>
   </Grid.ColumnDefinitions>

   <StackPanel>
    <TextBlock Text="Salesforce Product Code"
               FontWeight="SemiBold"
               Margin="0,0,0,5"/>
    <TextBox x:Name="ProductCodeTextBox"
             Height="30"
             IsReadOnly="True"/>
   </StackPanel>

   <StackPanel Grid.Column="2">
    <TextBlock Text="Course Name"
               FontWeight="SemiBold"
               Margin="0,0,0,5"/>
    <TextBox x:Name="CourseNameTextBox"
             Height="30"
             IsReadOnly="True"/>
   </StackPanel>
  </Grid>

  <StackPanel Grid.Row="8">
   <TextBlock Text="Distributor"
              FontWeight="SemiBold"
              Margin="0,0,0,5"/>
   <TextBox x:Name="DistributorTextBox"
            Height="30"/>
  </StackPanel>

  <StackPanel Grid.Row="10">
   <TextBlock Text="Machine ID"
              FontWeight="SemiBold"
              Margin="0,0,0,5"/>
   <TextBox x:Name="MachineIdTextBox"
            Height="30"
            FontFamily="Consolas"/>
  </StackPanel>

  <Grid Grid.Row="12">
   <Grid.ColumnDefinitions>
    <ColumnDefinition Width="Auto"/>
    <ColumnDefinition Width="18"/>
    <ColumnDefinition Width="220"/>
   </Grid.ColumnDefinitions>

   <CheckBox x:Name="NeverExpiresCheckBox"
             VerticalAlignment="Center"
             IsChecked="True"
             Content="License never expires"
             Checked="NeverExpiresCheckBox_Changed"
             Unchecked="NeverExpiresCheckBox_Changed"/>

   <DatePicker Grid.Column="2"
               x:Name="ExpirationDatePicker"
               IsEnabled="False"/>
  </Grid>

  <Grid Grid.Row="14">
   <Grid.ColumnDefinitions>
    <ColumnDefinition Width="*"/>
    <ColumnDefinition Width="Auto"/>
   </Grid.ColumnDefinitions>

   <TextBlock x:Name="StatusTextBlock"
              VerticalAlignment="Center"
              TextWrapping="Wrap"/>

   <Button Grid.Column="1"
           Width="160"
           Height="38"
           FontWeight="SemiBold"
           Content="Generate License..."
           Click="GenerateLicenseButton_Click"/>
  </Grid>
 </Grid>
</Window>
