<Window x:Class="WebPackageLicenseGenerator.OperatorSetupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="License Operator Setup"
        Width="690"
        Height="430"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="16"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="16"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock FontSize="21"
                       FontWeight="SemiBold"
                       Text="License Operator Setup"/>
            <TextBlock Margin="0,5,0,0"
                       TextWrapping="Wrap"
                       Foreground="#555555"
                       Text="Use this screen when provisioning a primary or backup license-generation computer. Restore the existing signing identity; do not create a new one."/>
        </StackPanel>

        <Border Grid.Row="2"
                BorderBrush="#CCCCCC"
                BorderThickness="1"
                CornerRadius="4"
                Padding="14">
            <StackPanel>
                <TextBlock x:Name="SigningStatusTextBlock"
                           FontWeight="SemiBold"
                           TextWrapping="Wrap"/>
                <TextBlock x:Name="CatalogStatusTextBlock"
                           Margin="0,8,0,0"
                           TextWrapping="Wrap"/>
            </StackPanel>
        </Border>

        <StackPanel Grid.Row="4"
                    Orientation="Horizontal">
            <Button Width="195"
                    Margin="0,0,10,0"
                    Content="Restore Signing Key..."
                    Click="RestoreSigningKeyButton_Click"/>
            <Button Width="195"
                    Content="Import Course Catalog..."
                    Click="ImportCatalogButton_Click"/>
        </StackPanel>

        <TextBlock Grid.Row="6"
                   TextWrapping="Wrap"
                   Foreground="#666666"
                   Text="Recommended handoff: install the same Web Package Tools MSI, restore the same .wpkey, then import the current .wpcourses catalog. Keep the .wpkey password separate from the backup file."/>

        <StackPanel Grid.Row="8"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right">
            <Button Width="100"
                    Margin="0,0,10,0"
                    Content="Refresh"
                    Click="RefreshButton_Click"/>
            <Button Width="100"
                    Content="Close"
                    Click="CloseButton_Click"/>
        </StackPanel>
    </Grid>
</Window>
