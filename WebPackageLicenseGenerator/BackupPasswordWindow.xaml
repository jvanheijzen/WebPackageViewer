<Window x:Class="WebPackageLicenseGenerator.BackupPasswordWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Signing Key Recovery"
        Width="500"
        Height="300"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="16"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="16"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="16"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock x:Name="InstructionTextBlock"
                   Grid.Row="0"
                   TextWrapping="Wrap"/>

        <StackPanel Grid.Row="2">
            <TextBlock Text="Backup Password"
                       FontWeight="SemiBold"
                       Margin="0,0,0,5"/>
            <PasswordBox x:Name="PasswordBox"
                         Height="30"/>
        </StackPanel>

        <StackPanel x:Name="ConfirmationPanel"
                    Grid.Row="4">
            <TextBlock Text="Confirm Password"
                       FontWeight="SemiBold"
                       Margin="0,0,0,5"/>
            <PasswordBox x:Name="ConfirmPasswordBox"
                         Height="30"/>
        </StackPanel>

        <TextBlock x:Name="StatusTextBlock"
                   Grid.Row="6"
                   Foreground="DarkRed"
                   TextWrapping="Wrap"/>

        <StackPanel Grid.Row="8"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right">
            <Button Width="100"
                    Margin="0,0,10,0"
                    Content="Cancel"
                    Click="CancelButton_Click"/>
            <Button Width="100"
                    Content="Continue"
                    IsDefault="True"
                    Click="ContinueButton_Click"/>
        </StackPanel>
    </Grid>
</Window>
