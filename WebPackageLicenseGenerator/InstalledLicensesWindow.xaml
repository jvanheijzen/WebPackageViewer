<Window x:Class="WebPackageLicenseGenerator.InstalledLicensesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Installed Course Licenses"
        Width="1050"
        Height="520"
        MinWidth="850"
        MinHeight="440"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="14"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   TextWrapping="Wrap"
                   Foreground="#555555"
                   Text="Disable a local license to reproduce the activation workflow without permanently deleting it. These controls affect only this computer."/>

        <DataGrid Grid.Row="2"
                  x:Name="LicensesDataGrid"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  SelectionMode="Single">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Course"
                                    Binding="{Binding CourseName}"
                                    Width="2*"/>
                <DataGridTextColumn Header="Product Code"
                                    Binding="{Binding CourseId}"
                                    Width="150"/>
                <DataGridTextColumn Header="Distributor"
                                    Binding="{Binding Distributor}"
                                    Width="160"/>
                <DataGridTextColumn Header="Expires"
                                    Binding="{Binding Expires}"
                                    Width="100"/>
                <DataGridTextColumn Header="Status"
                                    Binding="{Binding Status}"
                                    Width="2*"/>
                <DataGridTextColumn Header="Storage"
                                    Binding="{Binding Storage}"
                                    Width="105"/>
            </DataGrid.Columns>
        </DataGrid>

        <Grid Grid.Row="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0"
                        Orientation="Horizontal">
                <Button Width="120"
                        Margin="0,0,8,0"
                        Content="Disable License"
                        Click="DisableButton_Click"/>
                <Button Width="120"
                        Margin="0,0,8,0"
                        Content="Enable License"
                        Click="EnableButton_Click"/>
                <Button Width="120"
                        Content="Delete License"
                        Click="DeleteButton_Click"/>
            </StackPanel>

            <Button Grid.Column="1"
                    Width="90"
                    HorizontalAlignment="Center"
                    Content="Refresh"
                    Click="RefreshButton_Click"/>

            <Button Grid.Column="2"
                    Width="90"
                    Content="Close"
                    Click="CloseButton_Click"/>
        </Grid>
    </Grid>
</Window>
