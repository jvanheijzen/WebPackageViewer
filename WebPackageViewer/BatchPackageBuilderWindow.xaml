<Window x:Class="WebPackageViewer.BatchPackageBuilderWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Batch Web Package Builder"
        Width="1120"
        Height="720"
        MinWidth="900"
        MinHeight="600"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="16"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="14"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="14"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock FontSize="22"
                       FontWeight="SemiBold"
                       Text="Batch Package Builder"/>
            <TextBlock Margin="0,5,0,0"
                       Foreground="#666666"
                       TextWrapping="Wrap"
                       Text="Choose a course folder and the builder will find every folder beneath it that contains index.html. Review the modules below, then build one EXE per module."/>
        </StackPanel>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="14"/>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="14"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <TextBlock Text="Course"
                           FontWeight="SemiBold"
                           Margin="0,0,0,5"/>
                <ComboBox x:Name="CourseComboBox"
                          Height="31"
                          DisplayMemberPath="DisplayName"/>
            </StackPanel>

            <StackPanel Grid.Column="2">
                <TextBlock Text="Output Folder"
                           FontWeight="SemiBold"
                           Margin="0,0,0,5"/>
                <TextBox x:Name="OutputFolderTextBox"
                         Height="31"
                         VerticalContentAlignment="Center"/>
            </StackPanel>

            <StackPanel Grid.Column="4"
                        Orientation="Horizontal"
                        VerticalAlignment="Bottom">
                <Button Width="125"
                        Height="31"
                        Margin="0,0,8,0"
                        Content="Browse Output..."
                        Click="BrowseOutputButton_Click"/>
                <Button Width="145"
                        Height="31"
                        Content="Add Course Folder..."
                        Click="AddCourseFolderButton_Click"/>
            </StackPanel>
        </Grid>

        <DataGrid Grid.Row="4"
                  x:Name="ItemsDataGrid"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  SelectionMode="Extended"
                  ItemsSource="{Binding Items}">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Module ID"
                                    Binding="{Binding ModuleId, UpdateSourceTrigger=PropertyChanged}"
                                    Width="90"/>
                <DataGridTextColumn Header="Module Name"
                                    Binding="{Binding ModuleName, UpdateSourceTrigger=PropertyChanged}"
                                    Width="2*"/>
                <DataGridTextColumn Header="Window Title"
                                    Binding="{Binding WindowTitle}"
                                    IsReadOnly="True"
                                    Width="2*"/>
                <DataGridTextColumn Header="Source Folder"
                                    Binding="{Binding SourceFolder}"
                                    IsReadOnly="True"
                                    Width="2.5*"/>
                <DataGridTextColumn Header="Output File"
                                    Binding="{Binding OutputFileName, UpdateSourceTrigger=PropertyChanged}"
                                    Width="1.8*"/>
                <DataGridTextColumn Header="Status"
                                    Binding="{Binding Status}"
                                    IsReadOnly="True"
                                    Width="115"/>
            </DataGrid.Columns>
        </DataGrid>

        <Grid Grid.Row="6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0"
                        Orientation="Horizontal">
                <Button Width="120"
                        Margin="0,0,8,0"
                        Content="Remove Selected"
                        Click="RemoveSelectedButton_Click"/>
                <Button Width="90"
                        Content="Clear"
                        Click="ClearButton_Click"/>
            </StackPanel>

            <CheckBox Grid.Column="1"
                      x:Name="RequireOfflineLicenseCheckBox"
                      Margin="24,0,0,0"
                      VerticalAlignment="Center"
                      IsChecked="True"
                      Content="Require offline license (protected payload)"/>

            <Button Grid.Column="2"
                    x:Name="BuildAllButton"
                    Width="140"
                    Height="38"
                    FontWeight="SemiBold"
                    Content="Build All"
                    Click="BuildAllButton_Click"/>
        </Grid>
    </Grid>
</Window>
