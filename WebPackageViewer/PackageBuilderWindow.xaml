<Window x:Class="WebPackageViewer.PackageBuilderWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Web Package Builder"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="CanResize"
        Height="790"
        Width="800">

    <Window.Resources>
        <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#2D2D30"/>
        <SolidColorBrush x:Key="ActiveTitleBarBackgroundBrush" Color="#1E1E1E"/>
        <SolidColorBrush x:Key="TitleBarForegroundBrush" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="TitleBarButtonHoverBrush" Color="#22FFFFFF"/>
        <SolidColorBrush x:Key="TitleBarButtonPressedBrush" Color="#33FFFFFF"/>

        <Style x:Key="TitleBarButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource TitleBarForegroundBrush}"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBackground"
                                Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBackground"
                                        Property="Background"
                                        Value="{DynamicResource TitleBarButtonHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBackground"
                                        Property="Background"
                                        Value="{DynamicResource TitleBarButtonPressedBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Height" Value="30"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="6,0"/>
        </Style>

        <Style TargetType="Button">
            <Setter Property="MinHeight" Value="30"/>
            <Setter Property="Padding" Value="12,4"/>
        </Style>
    </Window.Resources>

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="36"
                            ResizeBorderThickness="4"
                            GlassFrameThickness="0"
                            CornerRadius="12"
                            UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <Border Background="{DynamicResource WindowBackgroundBrush}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="36"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid x:Name="TitleBar"
                  Grid.Row="0"
                  Background="{DynamicResource ActiveTitleBarBackgroundBrush}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="46"/>
                    <ColumnDefinition Width="46"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal"
                            Margin="10,0,0,0"
                            VerticalAlignment="Center">
                    <Image Source="/WebPackageViewer.ico"
                           Width="24"
                           Height="24"
                           Margin="0,0,8,0"/>
                    <TextBlock Text="Web Package Builder"
                               Foreground="{DynamicResource TitleBarForegroundBrush}"
                               VerticalAlignment="Center"/>
                </StackPanel>

                <Button Grid.Column="1"
                        Style="{DynamicResource TitleBarButtonStyle}"
                        FontFamily="Segoe MDL2 Assets"
                        FontSize="12"
                        Content="&#xE921;"
                        Click="MinimizeButton_Click"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True"/>

                <Button Grid.Column="2"
                        Style="{DynamicResource TitleBarButtonStyle}"
                        FontFamily="Segoe MDL2 Assets"
                        FontSize="12"
                        Content="&#xE8BB;"
                        Click="CloseButton_Click"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True"/>
            </Grid>

            <ScrollViewer Grid.Row="1"
                          VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="24">

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Web Site Folder"
                                       Foreground="White"
                                       Margin="0,0,0,5"/>
                            <TextBox x:Name="SourceFolderTextBox"
                                     TextChanged="SourceFolderTextBox_TextChanged"/>
                        </StackPanel>
                        <Button Grid.Column="1"
                                Width="90"
                                Margin="10,21,0,0"
                                Content="Browse..."
                                Click="BrowseSourceButton_Click"/>
                    </Grid>

                    <Grid Margin="0,16,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Output EXE"
                                       Foreground="White"
                                       Margin="0,0,0,5"/>
                            <TextBox x:Name="OutputFileTextBox"/>
                        </StackPanel>
                        <Button Grid.Column="1"
                                Width="90"
                                Margin="10,21,0,0"
                                Content="Browse..."
                                Click="BrowseOutputButton_Click"/>
                    </Grid>

                    <StackPanel Margin="0,16,0,0">
                        <TextBlock Text="Window Title"
                                   Foreground="White"
                                   Margin="0,0,0,5"/>
                        <TextBox x:Name="WindowTitleTextBox"/>
                    </StackPanel>

                    <Grid Margin="0,16,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="20"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel>
                            <TextBlock Text="Initial URL"
                                       Foreground="White"
                                       Margin="0,0,0,5"/>
                            <TextBox x:Name="InitialUrlTextBox"
                                     Text="/index.html"/>
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Virtual Path"
                                       Foreground="White"
                                       Margin="0,0,0,5"/>
                            <TextBox x:Name="VirtualPathTextBox"
                                     Text="/"/>
                        </StackPanel>
                    </Grid>

                    <StackPanel Margin="0,16,0,0">
                        <TextBlock Text="Window Size"
                                   Foreground="White"
                                   Margin="0,0,0,5"/>
                        <TextBox x:Name="WindowSizeTextBox"
                                 Width="180"
                                 HorizontalAlignment="Left"
                                 Text="1280x800"/>
                    </StackPanel>

                    <Border Margin="0,18,0,0"
                            BorderBrush="#666666"
                            BorderThickness="1"
                            CornerRadius="4"
                            Padding="14">
                        <StackPanel>
                            <CheckBox x:Name="RequireOfflineLicenseCheckBox"
                                      Foreground="White"
                                      FontWeight="SemiBold"
                                      Content="Require offline license"
                                      Checked="RequireOfflineLicenseCheckBox_Changed"
                                      Unchecked="RequireOfflineLicenseCheckBox_Changed"/>

                            <TextBlock Margin="0,7,0,12"
                                       Foreground="#CCCCCC"
                                       TextWrapping="Wrap"
                                       Text="A license applies to the selected course. Every module packaged with the same Salesforce Product Code will use the same machine license."/>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel>
                                    <TextBlock Text="Course"
                                               Foreground="White"
                                               Margin="0,0,0,5"/>
                                    <ComboBox x:Name="CourseComboBox"
                                              Height="30"
                                              IsEnabled="False"
                                              DisplayMemberPath="DisplayName"
                                              SelectionChanged="CourseComboBox_SelectionChanged"/>
                                </StackPanel>

                                <Button Grid.Column="1"
                                        Width="110"
                                        Margin="10,21,0,0"
                                        Content="Add Course..."
                                        IsEnabled="False"
                                        x:Name="AddCourseButton"
                                        Click="AddCourseButton_Click"/>
                            </Grid>

                            <Grid Margin="0,12,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="20"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel>
                                    <TextBlock Text="Salesforce Product Code"
                                               Foreground="White"
                                               Margin="0,0,0,5"/>
                                    <TextBox x:Name="ProductCodeTextBox"
                                             IsReadOnly="True"
                                             IsEnabled="False"/>
                                </StackPanel>

                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Course Version"
                                               Foreground="White"
                                               Margin="0,0,0,5"/>
                                    <TextBox x:Name="CourseVersionTextBox"
                                             IsReadOnly="True"
                                             IsEnabled="False"/>
                                </StackPanel>
                            </Grid>

                            <StackPanel Margin="0,12,0,0">
                                <TextBlock Text="Canonical Course Name"
                                           Foreground="White"
                                           Margin="0,0,0,5"/>
                                <TextBox x:Name="CourseNameTextBox"
                                         IsReadOnly="True"
                                         IsEnabled="False"/>
                            </StackPanel>

                            <Grid Margin="0,12,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="20"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel>
                                    <TextBlock Text="Module ID"
                                               Foreground="White"
                                               Margin="0,0,0,5"/>
                                    <TextBox x:Name="ModuleIdTextBox"
                                             IsEnabled="False"/>
                                </StackPanel>

                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Module Name"
                                               Foreground="White"
                                               Margin="0,0,0,5"/>
                                    <TextBox x:Name="ModuleNameTextBox"
                                             IsEnabled="False"/>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Grid Margin="0,18,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock x:Name="StatusTextBlock"
                                   VerticalAlignment="Center"
                                   Foreground="White"/>

                        <Button Grid.Column="1"
                                x:Name="BuildButton"
                                Width="140"
                                Height="38"
                                FontWeight="SemiBold"
                                Content="Build Package"
                                Click="BuildButton_Click"/>
                    </Grid>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Border>
</Window>
